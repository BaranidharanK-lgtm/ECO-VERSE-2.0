# EcoVerse AI — Frontend Environment Configuration
# Copy this file to .env or set these in your deployment platform (Vercel, Netlify, Render, Cloudflare)

# Application Information
VITE_APP_TITLE="EcoVerse AI"
VITE_APP_VERSION="1.0.0"

# Optional Backend API Base URL
# If hosting the FastAPI backend separately (e.g. on Render/Railway), set this URL:
# VITE_API_BASE_URL=https://ecoverse-api.onrender.com
VITE_API_BASE_URL=

# Feature Flags
VITE_ENABLE_SIMULATED_TELEMETRY=true
VITE_DEMO_MODE=true
